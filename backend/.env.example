SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Local MongoDB. On Render, set MONGODB_URI to the Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGODB_URI=
MONGO_DB_NAME=edututor

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=EduTutor <your-email@gmail.com>
EMAIL_TIMEOUT=15
