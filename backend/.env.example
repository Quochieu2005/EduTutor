SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Local MongoDB. On Render, set MONGODB_URI to the Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGODB_URI=
MONGO_DB_NAME=edututor

# Admin must sign in again after this many seconds (1 hour).
ADMIN_SESSION_MAX_AGE=3600

# Cloudinary: copy these values from Cloudinary Console > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Folder gốc duy nhất trên Cloudinary. Ví dụ: Edututor/tutors, Edututor/banners.
CLOUDINARY_ROOT_FOLDER=Edututor

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=EduTutor <your-email@gmail.com>
EMAIL_TIMEOUT=15

# Social login API. These values remain only on backend / Render, never frontend.
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# JWT returned by /api/v1/accounts/. Use SECRET_KEY above to sign them.
API_JWT_ACCESS_TTL_MINUTES=15
API_JWT_REFRESH_TTL_DAYS=30
