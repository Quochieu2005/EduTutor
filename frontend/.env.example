# Copy this file to .env.local for local development. Never commit .env.local.

NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Vercel production value:
# NEXT_PUBLIC_API_URL=https://edututor-po0q.onrender.com/api

# These identifiers are safe to expose to the browser. Configure the matching
# secrets only in the Django/Render environment.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
